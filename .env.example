# Configuração pública incorporada no build. Nunca colocar credenciais em NEXT_PUBLIC_*.
# Sem variável, usa os contatos oficiais em src/lib/business.ts. Valor vazio desativa o canal.
NEXT_PUBLIC_CONTACT_EMAIL=contato@mdfreitas.com.br
# Número internacional real, sem +, espaços ou pontuação; entre 10 e 15 dígitos, sem zero inicial.
NEXT_PUBLIC_WHATSAPP_NUMBER=5516997379559
# Canal dedicado a pedidos de privacidade, confirmado pela responsável.
NEXT_PUBLIC_PRIVACY_EMAIL=
# Opcional: detecta automaticamente public/branding/mdfreitas-logo.png quando presente.
NEXT_PUBLIC_LOGO_PATH=
# Variável de servidor. Definir true APENAS em Production após aprovação de publicação.
# Mesmo com true, VERCEL_ENV=preview/development impede indexação.
SITE_INDEXABLE=false
